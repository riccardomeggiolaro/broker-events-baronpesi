# Nome host pubblico del broker (DNS che punta alla VPS). Finisce nel certificato
# del server e va impostato come "Host" negli in-out. Usato anche da Caddy per l'HTTPS.
BROKER_HOST=mqtt.example.com

# Porta MQTT/TLS pubblicata sulla VPS
BROKER_PUBLIC_PORT=8883

# Accesso al pannello
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-questa-password

# Cookie di sessione solo su HTTPS (lascia 1 se usi Caddy)
SESSION_HTTPS_ONLY=1

# Giorni di conservazione dello storico (0 = per sempre)
RETENTION_DAYS=90

# Dimensione massima di un messaggio in MB (pesata + foto + PDF in base64)
MAX_MESSAGE_MB=64

# Validità predefinita dei certificati client (giorni)
CLIENT_CERT_DAYS=3650

TZ=Europe/Rome
