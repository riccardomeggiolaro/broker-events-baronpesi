# Nome host pubblico del broker (DNS che punta alla VPS). Finisce nel certificato
# del server e va impostato come "Host" negli in-out. Usato anche da Caddy per l'HTTPS.
BROKER_HOST=mqtt.example.com

# Porta MQTT/TLS pubblicata sulla VPS
BROKER_PUBLIC_PORT=8883

# Accesso al pannello
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-questa-password

# Cookie di sessione solo su HTTPS (lascia 1 se usi Caddy)
SESSION_HTTPS_ONLY=1

# Giorni di conservazione dello storico (0 = per sempre)
RETENTION_DAYS=90

# Dimensione massima di un messaggio in MB (pesata + foto + PDF in base64)
MAX_MESSAGE_MB=64

# Validità dei certificati client (giorni). Gli in-out li rinnovano da soli
# quando mancano meno di 60 giorni alla scadenza.
CLIENT_CERT_DAYS=365

# Registrazione automatica: un in-out nuovo riceve subito il certificato
# (per bloccarlo chiudi il canale dal pannello). 0 = disattivata
ENROLL_ENABLED=1
# Porta HTTPS di registrazione pubblicata (da impostare negli in-out se diversa da 8884)
ENROLL_PUBLIC_PORT=8884

# Accesso remoto agli in-out dal pannello (pagine, API e websocket attraverso MQTT),
# sulla stessa porta del pannello: https://BROKER_HOST/<ID>/
REMOTE_ENABLED=1
# Secondi di attesa della risposta dell'in-out
REMOTE_TIMEOUT=60
# Terminale SSH verso gli in-out dal pannello (attraverso la stessa connessione MQTT)
SSH_ENABLED=1
# Chiusura del terminale dopo questi minuti senza attività (0 = mai)
SSH_IDLE_MINUTES=30
# Registrazione delle sessioni del terminale (1 = attiva) e dimensione massima in MB
SSH_RECORD=1
SSH_RECORD_MAX_MB=20
# Dimensione massima dei file scaricati/caricati dalla pagina del terminale (MB)
SFTP_MAX_MB=200

TZ=Europe/Rome
